# LeadForge AI Scraper — Environment Variables
# Copy this file to .env and fill in your values

# Serper.dev — free 2,500 searches/month
# Sign up at https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Google Places API — $200 free credit/month (~40k requests)
# Enable at: Google Cloud Console > APIs > Places API (New)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google Sheets — Service Account credentials
# Create at: Google Cloud Console > IAM > Service Accounts
# Download JSON key, share your sheet with the service account email
GOOGLE_SHEETS_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from your service account JSON (keep the \n characters)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Server config (optional)
PORT=3000
CONCURRENCY_LIMIT=5
REQUEST_DELAY_MS=1200
