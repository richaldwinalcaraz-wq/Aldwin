{
  "name": "leadforge-ai-scraper",
  "version": "1.0.0",
  "description": "AI-powered lead scraping engine for med spas, roofing companies, and aesthetic clinics",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "scrape": "node src/index.js scrape",
    "dev": "nodemon src/server.js",
    "build": "pkg src/server.js --targets node18-win-x64 --output dist/LeadForge.exe --compress GZip"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "public/**/*",
      ".env",
      "node_modules/playwright/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "axios": "^1.6.7",
    "cheerio": "^1.0.0",
    "csv-stringify": "^6.4.5",
    "dotenv": "^16.4.4",
    "express": "^4.18.3",
    "googleapis": "^140.0.1",
    "p-limit": "^3.1.0",
    "playwright": "^1.42.1",
    "winston": "^3.12.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "pkg": "^5.8.1",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
