# FinestBank Backend — Environment Variables
# Copy to .env for local development

DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000"]

# Database — asyncpg driver for FastAPI, psycopg2 driver for Alembic (set in alembic/env.py)
DATABASE_URL=postgresql+asyncpg://finestbank:finestbank@localhost:5432/finestbank

# Redis
REDIS_URL=redis://localhost:6379

# Auth
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
